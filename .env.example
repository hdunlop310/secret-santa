# Backend
# development or production (staging counts as production)
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://santa:santa@localhost:5432/santa
TEST_DATABASE_URL=postgresql+psycopg://santa:santa@localhost:5432/santa_test
# false on serverless hosts (Vercel), where Neon's pooler does the pooling
DATABASE_POOLING=true
# Public URL of the frontend, used to build links in emails and responses
APP_BASE_URL=http://localhost:5173
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
# Public URL of the API (one-click unsubscribe links in emails)
API_BASE_URL=http://localhost:8000
# Long random values in production, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-only-not-secret
CRON_SECRET=dev-cron-secret

# Email: console | smtp | resend
EMAIL_BACKEND=smtp
EMAIL_FROM=Secret Santa <santa@localhost>
SMTP_HOST=localhost
SMTP_PORT=1025
RESEND_API_KEY=

# Rate limits (per IP per hour)
RATE_LIMIT_GROUP_CREATE=10
RATE_LIMIT_EMAIL_SEND=20
# Per participant per hour
RATE_LIMIT_LINK_PREVIEW=60
# Draws and redraws per group per hour (each one emails everyone)
RATE_LIMIT_DRAW=10

# Frontend
VITE_API_URL=http://localhost:8000
